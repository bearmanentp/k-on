rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function has(permission) {
      return signedIn() && (
        request.auth.token.role == 'owner'
        || (request.auth.token.permissions is list && permission in request.auth.token.permissions)
      );
    }
    function isAssignedShopManager(shopId) {
      let shop = get(/databases/$(database)/documents/shops/$(shopId)).data;
      return has('shopManagers')
        && request.auth.token.email is string
        && (
          (shop.managerUids is list && request.auth.uid in shop.managerUids)
          || (shop.managerEmails is list && request.auth.token.email in shop.managerEmails)
        );
    }
    function managesShop(shopId) {
      return has('design') || isAssignedShopManager(shopId);
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if has('design');
    }
    match /privateConfig/{id} {
      allow read, write: if false;
    }
    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if has('events');

      match /seats/{seatId} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /seatLayouts/{id} {
      allow read: if has('events');
      allow create, update, delete: if has('events');
    }
    match /notices/{id} {
      allow read: if true;
      allow create, update, delete: if has('notices');
    }
    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if has('notices');
    }
    match /boardDefinitions/{id} {
      allow read: if true;
      allow create, update, delete: if has('notices');
    }
    match /boardPosts/{id} {
      allow read: if true;
      allow create, update, delete: if has('notices');
    }
    match /ads/{id} {
      allow read: if true;
      allow create, update, delete: if has('design') || has('notices');
    }
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['eventId','eventTitle','answers','createdAt','status'])
        && request.resource.data.status == 'received';
      allow read, update, delete: if has('applications');
    }
    match /adminNotices/{id} {
      allow read: if signedIn() && (
        request.auth.token.role == 'owner'
        || resource.data.audiences.hasAny(['all', request.auth.token.role])
        || resource.data.audiences.hasAny(request.auth.token.permissions)
      );
      allow create, update, delete: if has('users');
    }
    match /inquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow read: if signedIn() && (!resource.data.private || resource.data.userId == request.auth.uid || has('applications'));
      allow update, delete: if has('applications');
    }
    match /inquiryCategories/{id} {
      allow read: if true;
      allow create, update, delete: if has('applications');
    }
    match /reservations/{id} {
      // 예약 생성은 좌석·정원 중복 검사를 수행하는 reserveEvent callable만 담당합니다.
      allow create: if false;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || has('applications') || has('events'));
      allow update, delete: if has('applications') || has('events');
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'fcmTokens'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'fcmTokens', 'nickname', 'deletedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow read: if has('users');
    }
    match /nicknameClaims/{key} {
      allow read, write: if false;
    }
    match /pointHistory/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || has('users') || has('points'));
      allow write: if false;
    }
    match /accountMessages/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if has('applications') || has('events');
      allow read: if has('applications') || has('events');
    }
    match /products/{id} {
      allow read: if resource.data.active == true || (signedIn() && (request.auth.token.role == 'owner' || request.auth.token.permissions is list));
      allow create: if request.resource.data.shopId is string && managesShop(request.resource.data.shopId);
      // 디자인 담당자는 shopId가 없던 기존 상품도 정리할 수 있습니다.
      // 상점 담당자는 배정된 상점 안에서만 생성·수정·삭제할 수 있습니다.
      allow update: if has('design') || (
        resource.data.shopId is string
        && request.resource.data.shopId is string
        && isAssignedShopManager(resource.data.shopId)
        && isAssignedShopManager(request.resource.data.shopId)
      );
      allow delete: if has('design') || (
        resource.data.shopId is string && isAssignedShopManager(resource.data.shopId)
      );
    }
    match /shops/{id} {
      allow read: if true;
      allow create, update, delete: if has('design');
    }
    match /shopSettings/{id} {
      allow read: if true;
      allow create, update, delete: if has('design');
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'awaiting_transfer';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || has('applications'));
      allow update: if (has('applications') && (
          !(request.resource.data.status in ['payment_rejected_refund_pending', 'refund_rejected'])
          || (request.resource.data.adminRefundReason is string && request.resource.data.adminRefundReason.size() > 0)
        )) || (signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentReportedAt', 'buyerRefundReason', 'refundRequestedAt', 'updatedAt'])
        && ((resource.data.status == 'awaiting_transfer' && request.resource.data.status in ['payment_reported', 'canceled'])
          || (resource.data.status in ['payment_reported', 'payment_confirmed'] && request.resource.data.status == 'refund_requested')));
      allow delete: if has('applications');
    }
    match /pollVotes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /adminDirectory/{uid} {
      allow read: if signedIn() && request.auth.token.role == 'owner';
      allow write: if false;
    }
    match /adminAlerts/{id} {
      allow read: if has('design') || has('events') || has('notices') || has('applications') || has('users') || has('points');
      allow write: if false;
    }
    match /systemMetrics/{id} {
      allow read: if has('design') || has('events') || has('notices') || has('applications') || has('users') || has('points');
      allow write: if false;
    }
  }
}
